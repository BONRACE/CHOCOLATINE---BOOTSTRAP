# Django
DJANGO_SECRET_KEY="change-me-in-production"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL
# Développement local (docker-compose.yml fourni) :
DB_NAME=eventflow
DB_USER=eventflow
DB_PASSWORD=eventflow
DB_HOST=localhost
DB_PORT=5432

# Paiement
STRIPE_SECRET_KEY=""
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
FEDAPAY_API_KEY=""

# Email transactionnel (laisser vide en développement : les emails sont
# affichés dans la console via EMAIL_BACKEND=...console.EmailBackend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
